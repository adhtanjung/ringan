# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
# 1. Go to https://app.supabase.com
# 2. Select your project (or create a new one)
# 3. Go to Settings → API
# 4. Copy the Project URL → SUPABASE_URL
# 5. Copy the anon/public key → SUPABASE_PUBLISHABLE_KEY
# 6. Copy the service_role key → SUPABASE_SECRET_KEY (for server-side operations only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-key

# Application Configuration
API_BASE_URL=http://localhost:5554/
APP_ENV=development
APP_IS_DEV=true
API_SECRET=

# Node Environment
NODE_ENV=development
